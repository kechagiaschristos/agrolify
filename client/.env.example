VITE_API_BASE_URL=http://localhost:3000

# Public frontend origin used for canonical and social metadata.
VITE_SITE_URL=https://agrolify.com

# Optional. Required only for Google Maps rendering.
VITE_GOOGLE_MAPS_API_KEY=replace_with_your_google_maps_api_key

# Set this in Render's Environment Variables page for production.
# VITE_API_BASE_URL=https://api.agrolify.com
