# App secrets
SECRET_KEY_BASE=replace_with_a_long_random_secret
JWT_SECRET=replace_with_a_long_random_secret

# External services
OPENWEATHER_API_KEY=replace_with_a_long_random_secret

# Frontend and auth cookies
FRONTEND_URL=http://localhost:5173
AUTH_COOKIE_DOMAIN=

# Local PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=secret
DB_NAME=agrolify_development
DB_TEST_NAME=agrolify_test

# Set these in Render's Environment Variables page for production.
# RAILS_ENV=production
# DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DATABASE
# FRONTEND_URL=https://agrolify.com
# AUTH_COOKIE_DOMAIN=.agrolify.com
